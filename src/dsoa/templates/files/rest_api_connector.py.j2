    source_type: ClassVar[str] = "{{ spec.source_type.value }}"
    default_path: ClassVar[str] = "{{ spec.rest_target.default_path or '' }}"
    env_prefix: ClassVar[str] = "{{ spec.auth.env_prefix }}"

    DEFAULT_BASE_URL: ClassVar[str] = "{{ spec.rest_target.base_url }}"

    @classmethod
    def from_env(cls, prefix: str | None = None) -> {{ spec.connector_name }}:
        """Build the connector from environment variables.

        Reads {{ spec.auth.env_prefix }}BASE_URL for the target.
        Non-secret values fall back to the defaults above.

        Returns:
            A configured connector. No connection is opened until first use.
        """
        resolved_prefix = prefix or cls.env_prefix
        config = RestConnectionConfig.from_env(
            resolved_prefix,
            base_url=_env_or(resolved_prefix, "BASE_URL", cls.DEFAULT_BASE_URL),
        )
        return cls(config)
