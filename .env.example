# Copy to .env and source it:  cp .env.example .env && set -a && . ./.env && set +a
#
# .env is gitignored. Never commit real credentials — the whole project is a
# demonstration that connectors read secrets from the environment, so the repo
# has to practise what it generates.

# --- Local Postgres (npm run up — a local process, no Docker needed) -------
DSOA_PG_HOST=localhost
DSOA_PG_PORT=55432
DSOA_PG_DATABASE=dsoa_source
DSOA_PG_USERNAME=dsoa
DSOA_PG_PASSWORD=dsoa_local_dev
DSOA_PG_SSL_MODE=disable
DSOA_PG_POOL_SIZE=5
DSOA_PG_APPLICATION_NAME=dsoa-dev

# --- Framework --------------------------------------------------------------
DSOA_LOG_LEVEL=INFO

# --- Phase 2: extraction ----------------------------------------------------
# Without a key everything still runs: ScriptedClient serves canned responses,
# so tests, `npm run demo`, and `npm run eval:offline` all work offline.
# ANTHROPIC_API_KEY=
DSOA_LLM_MODEL=claude-sonnet-4-6
